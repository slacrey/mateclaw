{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "douyin.lead_acquisition.outreach_plan",
  "type": "object",
  "required": ["lead", "message", "follow_up"],
  "properties": {
    "lead": {
      "$ref": "douyin.lead_acquisition.lead_record"
    },
    "message": {
      "type": "string"
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_required": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}
