{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "douyin.lead_acquisition.lead_search_request",
  "type": "object",
  "required": ["industry", "icp"],
  "properties": {
    "industry": {
      "type": "string"
    },
    "icp": {
      "type": "string",
      "description": "Ideal customer profile in natural language."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string"
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    }
  },
  "additionalProperties": false
}
