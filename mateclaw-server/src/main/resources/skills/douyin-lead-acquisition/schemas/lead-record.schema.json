{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "douyin.lead_acquisition.lead_record",
  "type": "object",
  "required": ["account_name", "source_url", "fit_score", "evidence"],
  "properties": {
    "account_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_angle": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
