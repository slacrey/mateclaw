{
  "name": "mateclaw-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "MateClaw desktop shell",
  "author": "MateClaw",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "start": "pnpm prepare:resources && pnpm compile && electron .",
    "dist:dir": "pnpm prepare:resources && pnpm compile && electron-builder --dir --x64",
    "dist:win": "pnpm prepare:resources && pnpm compile && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^37.7.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "vip.mate.mateclaw",
    "productName": "MateClaw",
    "copyright": "Copyright © 2026 MateClaw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "splash/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server"
      },
      {
        "from": "resources/runtime",
        "to": "runtime"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MateClaw",
      "artifactName": "MateClaw_${version}_${arch}_Setup.${ext}"
    }
  }
}
